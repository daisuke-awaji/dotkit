{
  "name": "dotkit",
  "version": "0.3.0",
  "description": "UI made of dots — a zero-runtime CSS framework with React bindings.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daisuke-awaji/dotkit.git"
  },
  "homepage": "https://daisuke-awaji.github.io/dotkit/",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./css": "./dist/dotkit.css",
    "./dotkit.css": "./dist/dotkit.css",
    "./icons.json": "./dist/icons.json",
    "./glyphs.json": "./dist/glyphs.json",
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "icons": "node scripts/build-icons.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "docs:dev": "vite --config docs/vite.config.ts",
    "docs:build": "npm run build && vite build --config docs/vite.config.ts",
    "docs:preview": "vite preview --config docs/vite.config.ts"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.0"
  }
}
